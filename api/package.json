{
  "name": "moodbite-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "create-account": "tsx --env-file-if-exists=.env scripts/create-account.ts",
    "seed-demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=22" }
}
